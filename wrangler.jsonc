/**
 * Cloudflare Workers configuration — Jitben Ops Dashboard.
 * Deploy with: npx wrangler deploy
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jitben-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,

  // Static dashboard (index.html, assets) — served from the edge, ahead of the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  // Non-secret config. The (public, RLS-protected) anon key is safe here;
  // put it in place with: npx wrangler secret put SUPABASE_ANON_KEY
  "vars": {
    // Supabase is optional: /config.js forwards these to the browser when set.
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": "",

    // Live data source: "Jitben data dump" (fid, status, timestamps).
    // Must be shared as "Anyone with the link → Viewer" for the CSV to be public.
    "SHEET_ID": "1vIwR22w8QfYLpt9QlC4fpbQweJGgg0MdhPXv9oMB32M",
    "SHEET_NAME": "Sheet1",
    "SHEET_TTL_SECONDS": "120"
  },

  "observability": { "enabled": true }
}
